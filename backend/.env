# Deep Research Agent System - Environment Configuration

# OpenAI API Configuration (global defaults — users can override in Settings page)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# If using a proxy or alternative API (e.g. DeepSeek), set the base URL:
# OPENAI_BASE_URL=https://api.deepseek.com
# Leave empty to use default: https://api.openai.com/v1
OPENAI_BASE_URL=

# Optional: default model selection (users can override in Settings page)
OPENAI_MODEL=gpt-4o

# JWT Secret (change in production)
# JWT_SECRET_KEY=your-strong-secret-key
